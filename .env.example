# BAZA.sale — environment variables template
# Скопировать в .env, заполнить реальными значениями. .env НИКОГДА не коммитится (см. .gitignore).
# Полное описание — docs/operations/environments.md раздел 2.

# --- Публичные (безопасно иметь плейсхолдер здесь) ---
NODE_ENV=development
API_PORT=3000
WORKER_CONCURRENCY=5
MONGO_REPLICA_SET_NAME=rs0
CORS_ALLOWED_ORIGIN_MARKETPLACE=http://localhost:3001
CORS_ALLOWED_ORIGIN_ERP=http://localhost:3002
CORS_ALLOWED_ORIGIN_ADMIN=http://localhost:3003
# Список доверенных IP/CIDR reverse proxy перед API через запятую (например,
# приватный адрес nginx/caddy контейнера). Пусто — req.ip остаётся адресом
# сокета (без reverse proxy, локальная разработка). НЕ ставить "true" —
# это доверяло бы X-Forwarded-For от кого угодно, а не только от прокси.
TRUST_PROXY=
TILE_PROVIDER_URL=REPLACE_ME
# MapLibre style JSON URL for marketplace-web (OSM-compatible vector or raster style).
# Dev/test: e.g. MapTiler / Stadia / https://demotiles.maplibre.org/style.json
# Production: Self-hosted TileServer GL / Martin / enterprise vector tile provider with SLA.
# Do not point this directly at the public tile.openstreetmap.org tile server.
VITE_MAP_STYLE_URL=REPLACE_ME_OSM_COMPATIBLE_STYLE_URL
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_PRIVATE=baza-private
MINIO_BUCKET_PUBLIC=baza-public
# Base URL для готовых объектов public bucket (avatar/photo URLs, отдаваемых
# клиенту) — в dev совпадает с MINIO_ENDPOINT+bucket, в проде указывает на
# CDN/прокси перед MinIO, не на сам MinIO напрямую.
MINIO_PUBLIC_BASE_URL=http://localhost:9000/baza-public
# Redis — распределённый rate limiter для публичного reveal-contact
# (shared/rate-limit/redis-rate-limit.guard.ts). compose.runtime.yml
# собирает эту строку сам из REDIS_PASSWORD ниже; для локального запуска
# apps/api вне docker (`pnpm --filter api dev`) нужен явный REDIS_URL.
REDIS_URL=redis://localhost:6379
# Лимиты reveal-contact (дефолты — см. redis-rate-limit.guard.ts), опциональны.
RATE_LIMIT_REVEAL_CONTACT_IP_LIMIT=5
RATE_LIMIT_REVEAL_CONTACT_LISTING_LIMIT=20
RATE_LIMIT_REVEAL_CONTACT_WINDOW_SECONDS=60
# TTL (часы) для guest reveal-contact idempotency-записей (public-reveal-idempotency-record.schema.ts), опционален.
PUBLIC_REVEAL_IDEMPOTENCY_TTL_HOURS=48
# TTL (часы) для orphaned pending media cleanup (media-cleanup.ts), опционален.
MEDIA_ORPHAN_TTL_HOURS=24
# Публичный базовый URL API (без завершающего /), на который Telegram шлёт
# апдейты — MessengerService.addTelegramBot регистрирует webhook по
# {TELEGRAM_WEBHOOK_BASE_URL}/api/v1/public/messenger/telegram/{accountId}.
# Не секрет сам по себе, но должен указывать на реально доступный извне HTTPS-хост.
TELEGRAM_WEBHOOK_BASE_URL=REPLACE_ME
# Рассылка новостей ERP (docs/operations/news.md). Пусто — канал выключен:
# ERP не предлагает отправку, доставки не ставятся в очередь.
# Почта: SMTP-сервер и адрес отправителя (например "BAZA <news@baza.sale>").
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
MAIL_FROM=
# Бот уведомлений платформы (создаётся в @BotFather, это НЕ боты организаций
# из «Чатов»): имя без @. Сотрудник привязывает его в ERP «Профиль → Уведомления».
TELEGRAM_NOTIFY_BOT_USERNAME=
# Адрес ERP для ссылки «Открыть в BAZA» в письме и Telegram (без завершающего /).
ERP_PUBLIC_URL=http://localhost:3002

# --- Секретные (реальные значения — только в .env, вне git) ---
MONGO_URI=REPLACE_ME
REDIS_PASSWORD=REPLACE_ME
MINIO_ACCESS_KEY=REPLACE_ME
MINIO_SECRET_KEY=REPLACE_ME
SESSION_SECRET=REPLACE_ME
NBG_EXCHANGE_RATE_API_KEY=REPLACE_ME
TILE_PROVIDER_API_KEY=REPLACE_ME
# Рассылка новостей: логин/пароль SMTP и токен бота уведомлений.
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_NOTIFY_BOT_TOKEN=
