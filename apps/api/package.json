{
  "name": "@baza/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.api.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "jest --config jest.config.js",
    "test:integration": "jest --config jest.integration.config.js",
    "clean": "rm -rf dist",
    "actuality:expire-overdue": "ts-node src/jobs/actuality-expire.command.ts",
    "bookings:expire-overdue": "ts-node src/jobs/booking-expire.command.ts",
    "grants:backfill-defaults": "ts-node src/jobs/grants-backfill.command.ts",
    "migrate:legacy-leads": "ts-node src/jobs/migrate-legacy-leads.command.ts",
    "export:legacy-leads": "ts-node src/jobs/export-legacy-leads.script.ts"
  },
  "dependencies": {
    "@baza/config": "workspace:*",
    "@baza/contracts": "workspace:*",
    "@baza/development": "workspace:*",
    "@baza/domain-events": "workspace:*",
    "@baza/media-storage": "workspace:*",
    "@baza/messenger": "workspace:*",
    "@baza/notifications": "workspace:*",
    "@baza/observability": "workspace:*",
    "@baza/property-assets": "workspace:*",
    "@baza/publication": "workspace:*",
    "@baza/tenant-scope": "workspace:*",
    "@fastify/cookie": "^10.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-fastify": "^11.2.3",
    "argon2": "^0.41.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.1",
    "file-type": "^22.0.2",
    "ioredis": "^5.4.1",
    "mongoose": "^8.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@baza/eslint-config": "workspace:*",
    "@baza/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.3",
    "@types/ioredis-mock": "^8.2.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
